{
  "schemaVersion": 1,
  "repository": "berialcheng/cursor-harness-provider",
  "registry": "https://registry.npmjs.org/",
  "packages": {
    "native": "@cursor-harness-provider/native",
    "pi": "@cursor-harness-provider/pi",
    "opencode": "@cursor-harness-provider/opencode"
  },
  "platforms": [
    {
      "platform": "darwin-arm64",
      "target": "aarch64-apple-darwin",
      "runner": "macos-15"
    },
    {
      "platform": "darwin-x64",
      "target": "x86_64-apple-darwin",
      "runner": "macos-15-intel"
    },
    {
      "platform": "linux-x64-gnu",
      "target": "x86_64-unknown-linux-gnu",
      "runner": "ubuntu-22.04"
    }
  ],
  "support": {
    "darwin": "macOS 15 or newer",
    "linux": "x64 GNU, Ubuntu 22.04 / glibc 2.35 or newer",
    "unsupported": [
      "Windows",
      "Linux arm64",
      "musl"
    ]
  }
}
